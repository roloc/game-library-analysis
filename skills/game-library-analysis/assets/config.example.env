# Copy this file to config.env in the folder you run the pipeline from, and
# fill in what you have. Keys stay on this machine and are only ever read by
# the scripts, never printed or logged. Each key is sent only to the service
# that issued it (Steam, OpenXBL, Sony). Never commit config.env - if the
# folder is a git repository, add config.env and data/ to its .gitignore.
#
# Then the whole pipeline is one command:
#     python run.py

# ---- Steam ----
# Free key: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
# Your vanity name (the bit after steamcommunity.com/id/) ...
STEAM_VANITY=
# ... or your 64-bit SteamID instead:
STEAM_ID=

# ---- Xbox (optional) ----
# Free key: https://xbl.io (sign in with the Microsoft account to analyze)
OPENXBL_API_KEY=

# ---- PlayStation (optional - read this first) ----
# The NPSSO token is PASSWORD-EQUIVALENT for your PSN account, and Sony has
# been known to ban accounts for heavy unofficial API use (a one-shot library
# pull is very unlikely to trip that, but the risk is yours). Requires the
# psnawp package: pip install PSNAWP
#
# To get the token: sign in at playstation.com in your browser, then visit
#   https://ca.account.sony.com/api/v1/ssocookie
# and copy the npsso value. Consider logging out of that browser session
# afterwards (which invalidates the token) once your pull is done.
PSN_NPSSO=

# ---- Output ----
OUT_DIR=data
WORKBOOK=data/library.xlsx
REPORT=data/report.html
